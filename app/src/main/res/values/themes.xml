<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MobileBasedSACCOManagement" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryVariant">@color/primary_navy_dark</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorSecondaryContainer">@color/accent_green_light</item>
        <item name="android:statusBarColor">@color/primary_navy_dark</item>
        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <style name="Theme.MobileBasedSACCOManagement" parent="Base.Theme.MobileBasedSACCOManagement" />

    <!-- Custom Button Styles -->
    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_navy</item>
        <item name="android:textColor">@color/primary_navy</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>
